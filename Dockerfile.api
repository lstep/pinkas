FROM golang:1.26-bookworm AS builder

WORKDIR /app

COPY go.mod go.sum* ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=1 GOOS=linux go build -o /mostdoc ./cmd/server

FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    libsqlite3-0 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /mostdoc /usr/local/bin/mostdoc

RUN mkdir -p /data

EXPOSE 3000

CMD ["mostdoc"]
